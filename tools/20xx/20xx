#!/usr/bin/env bash
# 20xx launcher wrapper. Resolves symlinks so it works from PATH, and prefers a
# Python that has tkinter so the `gui` subcommand works.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SELF")"
PY=""
for cand in /home/linuxbrew/.linuxbrew/bin/python3 python3 python3.14 python3.13 python3.12; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c 'import tkinter' >/dev/null 2>&1; then
        PY="$(command -v "$cand")"
        break
    fi
done
[ -z "$PY" ] && PY="python3"
exec "$PY" "$DIR/20xx.py" "$@"
