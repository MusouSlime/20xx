+/* Headless frame-capture device (MMLC mod): keeps the last rendered frame so a
+ * host process can pull it without a window/renderer. Added by the mmlc-mod
+ * Mesen host build; see tools/mesen_host/. */
+class CaptureRenderer : public IRenderingDevice
+{
+private:
+	std::mutex _lock;
+	std::vector<uint32_t> _buffer;
+	uint32_t _width = 0, _height = 0, _seq = 0;
+public:
+	void UpdateFrame(RenderedFrame& frame) override {
+		std::lock_guard<std::mutex> g(_lock);
+		if(frame.FrameBuffer && frame.Width && frame.Height) {
+			_width = frame.Width; _height = frame.Height;
+			_buffer.resize((size_t)_width * _height);
+			memcpy(_buffer.data(), frame.FrameBuffer, _buffer.size() * sizeof(uint32_t));
+			_seq++;
+		}
+	}
+	void ClearFrame() override {}
+	void Render(RenderSurfaceInfo&, RenderSurfaceInfo&) override {}
+	void Reset() override {}
+	void SetExclusiveFullscreenMode(bool, void*) override {}
+
+	uint32_t* GetBuffer(uint32_t* w, uint32_t* h, uint32_t* seq) {
+		std::lock_guard<std::mutex> g(_lock);
+		*w = _width; *h = _height; *seq = _seq;
+		return _buffer.empty() ? nullptr : _buffer.data();
+	}
+};
+
+/* Headless audio-capture device (MMLC mod): buffers the mixed audio so the
+ * host can pull it and the proxy can play it. */
+class CaptureAudio : public IAudioDevice
+{
+private:
+	std::mutex _lock;
+	std::vector<int16_t> _ring;
+	size_t _readPos = 0, _writePos = 0;
+	uint32_t _sampleRate = 48000;
+	bool _stereo = true;
+public:
+	CaptureAudio() { _ring.resize((size_t)48000 * 2 * 4); /* 4s stereo */ }
+	void PlayBuffer(int16_t *soundBuffer, uint32_t sampleCount, uint32_t sampleRate, bool isStereo) override {
+		std::lock_guard<std::mutex> g(_lock);
+		_sampleRate = sampleRate; _stereo = isStereo;
+		uint32_t n = sampleCount * (isStereo ? 2 : 1);
+		size_t cap = _ring.size();
+		for(uint32_t i = 0; i < n; i++) {
+			_ring[_writePos] = soundBuffer[i];
+			_writePos = (_writePos + 1) % cap;
+			if(_writePos == _readPos) { _readPos = (_readPos + 1) % cap; }
+		}
+	}
+	void Stop() override {}
+	void Pause() override {}
+	void ProcessEndOfFrame() override {}
+	string GetAvailableDevices() override { return ""; }
+	void SetAudioDevice(string) override {}
+	AudioStatistics GetStatistics() override { return {}; }
+
+	void Clear() {
+		std::lock_guard<std::mutex> g(_lock);
+		_readPos = _writePos = 0;
+	}
+
+	uint32_t Read(int16_t *out, uint32_t maxSamples, uint32_t *sampleRate, bool *stereo) {
+		std::lock_guard<std::mutex> g(_lock);
+		*sampleRate = _sampleRate; *stereo = _stereo;
+		size_t cap = _ring.size();
+		uint32_t avail = (uint32_t)((_writePos >= _readPos) ? (_writePos - _readPos) : (cap - _readPos + _writePos));
+		uint32_t n = avail < maxSamples ? avail : maxSamples;
+		for(uint32_t i = 0; i < n; i++) {
+			out[i] = _ring[_readPos];
+			_readPos = (_readPos + 1) % cap;
+		}
+		return n;
+	}
+};
+
