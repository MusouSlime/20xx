+	/* MMLC mod: enable the headless capture renderer before InitializeEmu, and
+	 * pull the latest frame with GetVideoBuffer (0xAARRGGBB, row-major). */
+	DllExport void __stdcall EnableCaptureRenderer(bool enabled) { _captureMode = enabled; }
+
+	DllExport uint32_t* __stdcall GetVideoBuffer(uint32_t* width, uint32_t* height, uint32_t* seq)
+	{
+		if(!_captureRenderer) {
+			if(width) *width = 0;
+			if(height) *height = 0;
+			if(seq) *seq = 0;
+			return nullptr;
+		}
+		return _captureRenderer->GetBuffer(width, height, seq);
+	}
+
+	/* MMLC mod: headless audio capture (interleaved int16; the proxy plays it). */
