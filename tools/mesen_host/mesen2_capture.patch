+	DllExport uint32_t __stdcall GetAudioBuffer(int16_t* out, uint32_t maxSamples, uint32_t* sampleRate, uint32_t* stereo)
+	{
+		if(!_captureAudio) { if(sampleRate) *sampleRate = 0; if(stereo) *stereo = 0; return 0; }
