# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for 20XX.

Build a one-directory bundle (Linux AppImage) or a one-file exe (Windows):

    ONEFILE=0 python -m PyInstaller --noconfirm --clean packaging/20xx.spec
    ONEFILE=1 python -m PyInstaller --noconfirm --clean packaging/20xx.spec

The bundle contains only 20XX code/data. It never contains ROMs, game assets,
the Steamless tool, or the Mesen2 core (all user-supplied at runtime).
"""
import os

ROOT = os.path.abspath(os.path.join(SPECPATH, ".."))
ONEFILE = os.environ.get("ONEFILE", "0") == "1"

datas = [
    (os.path.join(ROOT, "tools", "mmlc", "patches"), "mmlc/patches"),
    (os.path.join(ROOT, "tools", "mesen_host"), "tools/mesen_host"),
    (os.path.join(ROOT, "build", "build_proxy.sh"), "build"),
    (os.path.join(ROOT, "build", "gen_def.py"), "build"),
    (os.path.join(ROOT, "src", "proxy"), "src/proxy"),
    (os.path.join(ROOT, "config"), "config"),
    (os.path.join(ROOT, "docs"), "docs"),
    (os.path.join(ROOT, "README.md"), "."),
    (os.path.join(ROOT, "LICENSE"), "."),
]
# Optional icon (generated by packaging/make_icon.sh, committed as PNG/ICO).
_icon = os.path.join(ROOT, "packaging", "20xx.ico" if os.name == "nt" else "20xx.png")
icon = _icon if os.path.exists(_icon) else None

hiddenimports = [
    "tkinter",
    "tkinter.ttk",
    "tkinter.filedialog",
    "tkinter.scrolledtext",
    "mmlc",
    "mmlc.collections",
    "mmlc.hardmode",
    "mmlc.locale_mod",
    "mmlc.wily",
]

a = Analysis(
    [os.path.join(ROOT, "tools", "20xx", "20xx.py")],
    pathex=[os.path.join(ROOT, "tools")],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=["pytest", "_pytest"],
    noarchive=False,
)
pyz = PYZ(a.pure)

if ONEFILE:
    exe = EXE(
        pyz,
        a.scripts,
        a.binaries,
        a.datas,
        [],
        name="20XX",
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=False,
        console=True,
        disable_windowed_traceback=False,
        argv_emulation=False,
        target_arch=None,
        codesign_identity=None,
        entitlements_file=None,
        icon=icon,
    )
else:
    exe = EXE(
        pyz,
        a.scripts,
        [],
        exclude_binaries=True,
        name="20XX",
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=False,
        console=True,
        disable_windowed_traceback=False,
        argv_emulation=False,
        target_arch=None,
        codesign_identity=None,
        entitlements_file=None,
        icon=icon,
    )
    coll = COLLECT(
        exe,
        a.binaries,
        a.datas,
        strip=False,
        upx=False,
        name="20XX",
    )
